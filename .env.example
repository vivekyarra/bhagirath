# Copy to .env and fill in. Never commit .env.

# --- Core ---
BHAGIRATH_MODE=demo                     # demo (fictional data, simulated sends) | pilot (real channels)
BHAGIRATH_BASE_URL=http://localhost:8080 # public URL; used in officials' links and webhook signatures
DATABASE_URL=postgres://bhagirath:bhagirath@localhost:5432/bhagirath?sslmode=disable
BHAGIRATH_SECRET_KEY=                   # 32+ random bytes: openssl rand -base64 48   (required in pilot)
BHAGIRATH_LADDER_FILE=config/ladder.example.yaml   # pilot: config/ladder.local.yaml (git-ignored)
BHAGIRATH_PARTNER_NAME=                 # e.g. "Bhagirathpura Residents' Welfare Association"

# --- Logins ---
BHAGIRATH_ADMIN_USER=admin
BHAGIRATH_ADMIN_PASSWORD=               # 12+ chars (required in pilot)
BHAGIRATH_JUDGE_USER=judge              # demo mode only
BHAGIRATH_JUDGE_PASSWORD=               # demo mode only; default water-judge-2026

# --- Safety ---
BHAGIRATH_ADVISORY_REVIEWED_BY=         # "Dr <name>, <role>" — advisories are blocked in pilot until set
BHAGIRATH_REQUIRE_PARTNER_SIGNOFF=true
BHAGIRATH_AUDIO_RETENTION_DAYS=90

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                    # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=                  # any random string; also entered in the Meta console
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ADVISORY_TEMPLATE=             # approved template names for messages outside the 24 h window
WHATSAPP_CALLBACK_TEMPLATE=

# --- Telephony: Twilio (missed call → free callback IVR, verification calls) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Telephony: Exotel (Indian numbers) ---
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_KEY=                     # random string appended as ?key= to Passthru URLs

# --- Speech-to-text (Sarvam AI) ---
SARVAM_API_KEY=
SARVAM_STT_MODEL=saarika:v2.5

# --- Optional LLM for extraction/translation (never used for alerts) ---
LLM_PROVIDER=                           # anthropic | openai (any OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Email to officials ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
